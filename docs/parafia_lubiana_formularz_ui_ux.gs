function createParishPrototypeForm() {
  const form = FormApp.create('Parafia Lubiana – ocena projektu aplikacji (UI/UX)');
  form.setDescription('Prototyp: https://bf1.pl/parafialubiana/\n\nProsimy ocenić wygląd, kolorystykę, czcionki, czytelność, układ ekranów, nawigację, funkcjonalność projektową i kompletność informacji. Sprawdź widok desktop i mobile przełącznikami w prototypie. Nie testujemy jeszcze szybkości, instalacji PWA, push ani funkcji produkcyjnych. Wypełnienie: ok. 5–8 minut. Dane kontaktowe są opcjonalne.');
  form.setConfirmationMessage('Dziękujemy za ocenę prototypu aplikacji parafialnej!');
  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false);
  const sheet = SpreadsheetApp.create('Parafia Lubiana – wyniki konsultacji UI UX');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());
  const section = (title,help) => form.addSectionHeaderItem().setTitle(title).setHelpText(help || '');
  const choice = (title,values) => form.addMultipleChoiceItem().setTitle(title).setChoiceValues(values).setRequired(true);
  const note = title => form.addParagraphTextItem().setTitle(title).setRequired(false);
  const grid = (title,rows) => form.addGridItem().setTitle(title).setRows(rows).setColumns(['1 – bardzo źle','2','3','4','5 – bardzo dobrze','Nie oceniałem/am']).setRequired(true);
  section('1. Ogólna ocena projektu','Oceń projekt wizualny, nie działanie techniczne.');
  grid('1–5. Oceń elementy wizualne:', ['Ogólny wygląd i estetyka','Kolorystyka i kontrast','Czcionki i czytelność tekstów','Rozmieszczenie elementów i proporcje','Ikony i elementy graficzne']);
  note('6. Co zmienił(a)byś w wyglądzie aplikacji?');
  section('2. Nawigacja i użyteczność (UX)','Oceń intuicyjność interfejsu.');
  ['7. Czy menu i sposób poruszania się po aplikacji są intuicyjne?','8. Czy łatwo odnaleźć najważniejsze informacje?','9. Czy hierarchia informacji jest logiczna?','10. Czy przyciski, ikony i nazwy sekcji są zrozumiałe?'].forEach(q=>choice(q,['Tak','Częściowo','Nie','Nie oceniałem/am']));
  note('11. Co utrudnia poruszanie się po aplikacji?');
  section('3. Ocena sekcji i funkcji','Oceń sposób zaprojektowania ekranów, nie ich techniczne działanie.');
  grid('12–17. Oceń poszczególne sekcje:', ['Strona główna','Ogłoszenia parafialne','Intencje mszalne','Terminarz wydarzeń','Msze Święte i nabożeństwa','Informacje o parafii, kancelaria i kontakt']);
  note('18. Które sekcje wymagają zmian i dlaczego?');
  section('4. Kompletność informacji i funkcjonalność','Czy projekt odpowiada potrzebom parafian?');
  choice('19. Czy zaproponowane sekcje odpowiadają potrzebom parafian?',['Tak, zakres jest wystarczający','Częściowo, czegoś brakuje','Nie, zakres wymaga większych zmian']);
  note('20. Jakich informacji lub funkcji brakuje w projekcie?');
  note('21. Czy są sekcje lub elementy, które uważasz za zbędne?');
  choice('22. Czy sposób prezentacji terminarza i wydarzeń jest czytelny?',['Tak','Częściowo','Nie','Nie oceniałem/am']);
  section('5. Widok mobilny i komputerowy','Przełącz widok w prototypie; nie musisz używać dwóch urządzeń.');
  choice('23. Który widok projektu oceniasz?',['Oba – mobilny i komputerowy','Tylko mobilny','Tylko komputerowy']);
  const view = ['Bardzo dobrze','Dobrze','Przeciętnie','Źle','Nie oceniałem/am'];
  choice('24. Jak oceniasz projekt widoku mobilnego?',view);
  choice('25. Jak oceniasz projekt widoku komputerowego?',view);
  note('26. Co warto poprawić w układzie mobilnym lub komputerowym?');
  section('6. Podsumowanie','Wskaż mocne strony i priorytety zmian.');
  form.addScaleItem().setTitle('27. Jak oceniasz cały projekt aplikacji?').setBounds(1,5).setLabels('Bardzo źle','Bardzo dobrze').setRequired(true);
  note('28. Co najbardziej podoba Ci się w projekcie?');
  note('29. Jakie trzy zmiany wprowadził(a)byś w pierwszej kolejności?');
  note('30. Dodatkowe uwagi i sugestie');
  section('Opcjonalny kontakt','Dane kontaktowe nie są wymagane.');
  form.addTextItem().setTitle('Imię lub pseudonim (opcjonalnie)');
  form.addTextItem().setTitle('E-mail do ewentualnego kontaktu (opcjonalnie)');
  Logger.log('EDYCJA: '+form.getEditUrl());
  Logger.log('DLA TESTERÓW: '+form.getPublishedUrl());
  Logger.log('ARKUSZ: '+sheet.getUrl());
}
